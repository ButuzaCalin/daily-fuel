    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
